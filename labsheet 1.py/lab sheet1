print("\nQ30: Prime number") 
number = int(input("Enter an integer: "))

if number <= 1:
    print("The number is not prime.")
else:
    is_prime = True
    i = 2

    while i * i <= number:
        if number % i == 0:
            is_prime = False
            break
        i += 1

    if is_prime:
        print("The number is prime.")
    else:
        print("The number is not prime.") 