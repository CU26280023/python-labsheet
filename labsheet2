    if num1 % i == 0 and num2 % i == 0:
        hcf = i

print("HCF =", hcf)




print("\nQ29: LCM of two numbers")
num1 = int(input("Enter first number: "))
num2 = int(input("Enter second number: "))

if num1 < 0:
    num1 = -num1

if num2 < 0:
    num2 = -num2

if num1 == 0 or num2 == 0:
    lcm = 0
else:
    if num1 > num2:
        lcm = num1
    else:
        lcm = num2

    while True:
        if lcm % num1 == 0 and lcm % num2 == 0:
            break
        lcm += 1

print("LCM =", lcm)




print("\nQ30: Number is a strong")
num = int(input("Enter a number: "))

original = num
sum_of_factorials = 0

while num > 0:
    digit = num % 10
    
    # Find factorial of digit
    factorial = 1
    
    for i in range(1, digit + 1):
        factorial *= i
    
    sum_of_factorials += factorial
    num //= 10

if sum_of_factorials == original:
    print(original, "is a Strong number.")
else:
    print(original, "is not a Strong number.")



