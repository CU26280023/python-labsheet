print("\nQ23:Calculate average of marks from CSV file")
import csv

file = open("students.csv", "r")

reader = csv.DictReader(file)

total = 0
count = 0

for row in reader:
    total += int(row["Marks"])
    count += 1

if count > 0:
    average = total / count
    print("Average Marks:", average)
else:
    print("No records found")

file.close()




