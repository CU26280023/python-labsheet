print("\nQ30:Combine multiple CSV files into one file")

import csv

files = ["students1.csv", "students2.csv"]

output = open("combined.csv", "w", newline="")

writer = csv.writer(output)

header_written = False

for filename in files:

    file = open(filename, "r")

    reader = csv.reader(file)

    header = next(reader, None)

    if header and not header_written:
        writer.writerow(header)
        header_written = True

    for row in reader:
        writer.writerow(row)

    file.close()

output.close()

