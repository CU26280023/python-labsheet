print("\nQ18:Store unique words in another file")
file = open("sample.txt", "r")

words = file.read().split()

file.close()

unique = []

for word in words:
    if word not in unique:
        unique.append(word)

file = open("unique.txt", "w")

for word in unique:
    file.write(word + "\n")

file.close()

print("Unique words saved successfully!")




