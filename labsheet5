print("\nQ1: Create and display a tuple")
my_tuple = (10, 20, 30, 40, 50)

print("Tuple:", my_tuple)



print("\nQ2: Tuple with different data data types")
my_tuple = (10, "Python", 3.14, True)

print("Tuple:", my_tuple)




print("\nQ3: length of a tuple")
my_tuple = (10, 20, 30, 40, 50)

print("Length of tuple:", len(my_tuple))



print("\nQ4: Access tuple elements using indexing")
my_tuple = (10, 20, 30, 40, 50)

print("First element:", my_tuple[0])
print("Third element:", my_tuple[2])
print("Last element:", my_tuple[-1])



print("\nQ5: Access tuple elements using slicing")
my_tuple = (10, 20, 30, 40, 50)

print("Elements from index 1 to 3:", my_tuple[1:4])
print("First three elements:", my_tuple[:3])
print("Last two elements:", my_tuple[-2:])




print("\nQ6: Check whether an element exists in a tuple")
my_tuple = (10, 20, 30, 40, 50)

element = int(input("Enter element to search: "))

if element in my_tuple:
    print("Element exists in the tuple.")
else:
    print("Element does not exist in the tuple.")



print("\nQ7: Count occurrences of an element")
my_tuple = (10, 20, 10, 30, 10, 40)

element = int(input("Enter element: "))

print("Occurrences:", my_tuple.count(element))




print("\nQ8: index of an element")
my_tuple = (10, 20, 30, 40, 50)

element = int(input("Enter element: "))

if element in my_tuple:
    print("Index of element:", my_tuple.index(element))
else:
    print("Element not found.")



print("\nQ9: Concatenate two tuples")
tuple1 = (1, 2, 3)
tuple2 = (4, 5, 6)

result = tuple1 + tuple2

print("Concatenated tuple:", result)



print("\nQ10: Repeat a tuple n times")
my_tuple = (1, 2, 3)

n = int(input("Enter number of repetitions: "))

result = my_tuple * n

print("Repeated tuple:", result)



