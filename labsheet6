print("\nQ22: Find duplicate elements in a list using a set")
numbers = [1, 2, 3, 2, 4, 3, 5]
seen = set()
duplicates = set()

for n in numbers:
    if n in seen:
        duplicates.add(n)
    else:
        seen.add(n)

print("Duplicate elements:", duplicates)




