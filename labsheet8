print("\nQ26:export_csv.py") 
import sqlite3
import csv

try:
    conn = sqlite3.connect("student_db.db")
    cursor = conn.cursor()

    cursor.execute("SELECT * FROM students")

    records = cursor.fetchall()

    # Get column names
    headers = [description[0] for description in cursor.description]

    # Write data into CSV file
    with open("students.csv", "w", newline="") as file:
        writer = csv.writer(file)

        writer.writerow(headers)
        writer.writerows(records)

    print("Data exported to students.csv successfully!")

    conn.close()

except (sqlite3.Error, OSError) as e:
    print("Error:", e)




print("\nQ27:import_csv.py") 
import sqlite3
import csv

try:
    conn = sqlite3.connect("student_db.db")
    cursor = conn.cursor()

    # Read CSV file
    with open("students.csv", "r") as file:
        reader = csv.reader(file)

        next(reader)  # Skip header

        records = [
            (int(row[0]), row[1], int(row[2]), float(row[3]))
            for row in reader
        ]

    # Insert CSV records into database
    cursor.executemany("""
        INSERT INTO students (id, name, age, marks)
        VALUES (?, ?, ?, ?)
    """, records)

    conn.commit()

    print("CSV data imported successfully!")

    conn.close()

except (sqlite3.Error, OSError, ValueError) as e:
    print("Error:", e)





