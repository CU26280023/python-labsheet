print("\nQ1: sum and average of elements")
numbers = list(map(float, input("Enter list elements separated by spaces: ").split()))

total = 0

for number in numbers:
    total += number

average = total / len(numbers)

print("List:", numbers)
print("Sum:", total)
print("Average:", average)



print("\nQ2: rotate a list by n position")
numbers = list(map(int, input("Enter list elements: ").split()))
n = int(input("Enter number of positions to rotate: "))

n = n % len(numbers)

rotated_list = numbers[-n:] + numbers[:-n] if n != 0 else numbers

print("Original List:", numbers)
print("Rotated List:", rotated_list)



print("\nQ3: Remove all negative numbers from a list")
numbers = list(map(int, input("Enter list elements: ").split()))

positive_list = []

for number in numbers:
    if number >= 0:
        positive_list.append(number)

print("Original List:", numbers)
print("List after removing negative numbers:", positive_list)




print("\nQ4:Find product of all elemnts in a list")
